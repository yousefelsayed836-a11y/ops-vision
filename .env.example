DATABASE_URL=postgresql://opsvision:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/opsvision
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_ENV=development
ALLOW_SIMULATION=false
# Optional host-only port for a shared Droplet. Keep the binding on 127.0.0.1.
OPSVISION_HOST_PORT=3100
# Email is an outbox until an SMTP provider is configured. Never log tokens.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Dedicated test database only. Never point tests at production.
TEST_DATABASE_URL=
# Optional absolute Python executable for the local video worker; otherwise python/python3.
OPSVISION_PYTHON=

# Simplified UI: camera IP metadata + bay operations; video/rules workers disabled.
OPSVISION_OPERATIONS_ONLY=true

# Uploaded-video analysis is explicitly enabled; general automation stays off.
OPSVISION_VIDEO_ANALYSIS=true
