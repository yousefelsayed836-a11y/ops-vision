{
  "name": "opsvision",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs next dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/run.mjs prisma generate && node scripts/run.mjs next build --webpack",
    "start": "node scripts/run.mjs next start --hostname 0.0.0.0",
    "lint": "node scripts/run.mjs eslint .",
    "typecheck": "node scripts/run.mjs tsc --noEmit",
    "test": "node scripts/run.mjs vitest run",
    "test:integration": "node scripts/run.mjs vitest run --config vitest.integration.config.ts",
    "db:generate": "node scripts/run.mjs prisma generate",
    "db:migrate": "node scripts/run.mjs prisma migrate deploy",
    "db:dev": "node scripts/pglite-dev.mjs",
    "admin:create": "node scripts/run.mjs tsx scripts/create-admin.ts",
    "admin:setup": "node scripts/admin-prompt.mjs",
    "worker": "node scripts/run.mjs tsx scripts/worker.ts",
    "notifications:worker": "node scripts/run.mjs tsx scripts/notification-worker.ts",
    "video:worker": "node scripts/run.mjs tsx scripts/video-worker.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.14",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/pdfkit": "^0.17.7",
    "@types/web-push": "^3.6.4",
    "better-auth": "^1.7.14",
    "dotenv": "^17.2.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "next-intl": "^4.8.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@next/swc-wasm-nodejs": "^16.4.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@swc/core@1.16.18": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
